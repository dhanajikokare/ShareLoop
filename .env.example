# ==========================================
# ShareLoop Environment Configuration
# ==========================================

# Core Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL 8.0)
DB_ENGINE=django.db.backends.mysql
DB_NAME=shareloop_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Platform & Business Settings
PLATFORM_COMMISSION_PERCENTAGE=5.0
DEFAULT_CITY=Pune
DEFAULT_STATE=Maharashtra
TIME_ZONE=Asia/Kolkata

# Razorpay Payment Gateway (Test Mode / Production)
# Leave empty to keep payments in safe test/simulation mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Settings (Console backend by default for local testing)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ShareLoop <no-reply@shareloop.in>
